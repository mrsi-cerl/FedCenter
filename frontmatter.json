{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "astro",
  "frontMatter.preview.host": "http://localhost:4321",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "programs",
      "pageBundle": false,
      "previewPath": "",
      "clearEmpty": true,
      "fields": [
        {
          "title": "ItemId",
          "name": "itemId",
          "type": "number"
        },
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Program Areas",
          "name": "programAreas",
          "type": "block",
          "fieldGroup": [
            "Acquisition",
            "Chemical Management",
            "Cleanup",
            "Climate Resilience",
            "Cultural Resources",
            "Electronics Stewardship",
            "Energy",
            "Environmental Compliance",
            "Environmental Management Systems (EMS)",
            "Greenhouse Gases",
            "High Performance Buildings",
            "Natural Resources",
            "NEPA",
            "PFAS",
            "Pollution Prevention",
            "Sustainability",
            "Transportation",
            "Water Efficiency"
          ]
        },
        {
          "title": "Publishing date",
          "name": "publishDate",
          "type": "datetime",
          "default": "{{month}}/{{day}}/{{year}}",
          "dateFormat": "mm/d/yyyy",
          "isPublishDate": true
        },
        {
          "title": "Expiration date",
          "name": "expiryDate",
          "type": "datetime",
          "dateFormat": "mm/dd/yyyy"
        },
        {
          "title": "Event Type",
          "name": "eventType",
          "type": "choice",
          "choices": ["Conferences", "Meetings", "Training", "Other"]
        },
        {
          "title": "Event Start",
          "name": "startDate",
          "type": "datetime"
        },
        {
          "title": "Event End",
          "name": "endDate",
          "type": "datetime"
        },
        {
          "title": "External URL",
          "name": "externalUrl",
          "type": "string"
        }
      ]
    }
  ],
