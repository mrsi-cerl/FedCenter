---
import type { DataEntryMap } from "astro:content";
import { getCollection } from "astro:content";

const {
  title,
  posts,
  showYear = false,
  announcementCount = 3,
  buttonTitle = "See All Announcements",
} = Astro.props;

// const pDate = new Date(post.data.pubDate);

console.log(
  posts
    ? "posts passed from parent"
    : "no posts supplied, fetching default announcements"
);

const allAnnouncements = posts
  ? posts
  : await getCollection("announcements", ({ data }) => {
      return data;
    });

//sort our announcements by date, recent to oldest, and then get the most recent 3
const recentThreeAnouncements = allAnnouncements
  .sort(
    (a: any, b: any) =>
      new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
  ) // a - b for oldest to most recent
  .slice(0, announcementCount);
---

<div class="grid-container border-1px border-primary radius-md">
  <div class="grid-row bg-primary full-row">
    <div class="grid-col">
      <h2 class="text-white text-center">{title}</h2>
    </div>
  </div>
  {
    recentThreeAnouncements.map((announcement: any) => (
      <div class="grid-row border-bottom height-10">
        <div class="grid-col-1 display-flex flex-justify-center">
          <div class="display-flex flex-column flex-justify-center height-10 width-5">
            <p class="font-mono-xl text-heavy margin-0 text-center">
              {new Date(announcement.data.pubDate).getDate()}
            </p>
            <p class="font-mono-sm margin-0 text-center">
              {new Date(announcement.data.pubDate).toLocaleString("default", {
                month: "short",
              })}
              {showYear && new Date(announcement.data.pubDate).getFullYear()}
            </p>
          </div>
        </div>
        <div class="grid-col-3 display-flex flex-column flex-justify-center height-10 padding-right-2">
          <p class="truncate-overflow margin-0">{announcement.data.title}</p>
        </div>
        <div class="grid-col display-flex flex-column flex-justify-center height-10 padding-left-2">
          <p class="truncate-overflow margin-0 text-indent-5">
            {announcement.body}
          </p>
        </div>
      </div>
    ))
  }
  <a href="whats-new" class="usa-button margin-2">{buttonTitle}</a>
</div>
