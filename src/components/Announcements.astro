---
import { getCollection } from "astro:content";

const {
  title,
  posts,
  showYear = false,
  announcementCount = 3,
  buttonTitle = "See All Announcements",
  url = "whats-new",
} = Astro.props;

// const pDate = new Date(post.data.publishDate);

console.log(
  posts
    ? "posts passed from parent"
    : "no posts supplied, fetching default announcements"
);

const allAnnouncements = posts
  ? posts
  : await getCollection("announcements", ({ data }) => {
      return data;
    });

//sort our announcements by date, recent to oldest, and then get the most recent 3
const recentThreeAnouncements = allAnnouncements
  .sort(
    (a: any, b: any) =>
      new Date(b.data.publishDate).valueOf() -
      new Date(a.data.publishDate).valueOf()
  ) // a - b for oldest to most recent
  .slice(0, announcementCount);
---

<div class="grid-container border-1px border-primary radius-md">
  <div class="grid-row bg-primary full-row">
    <div class="grid-col">
      <h2 class="text-white text-center">{title}</h2>
    </div>
  </div>
  {
    recentThreeAnouncements.map((announcement: any) => (
      <div class="grid-row border-bottom padding-top-2 padding-bottom-2">
        <div class="grid-col-1 display-flex flex-justify-center">
          <div class="display-flex flex-column flex-justify-center width-5">
            <p class="font-mono-xl text-heavy margin-0 text-center">
              {new Date(announcement.data.publishDate).getDate()}
            </p>
            <p class="font-mono-sm margin-0 text-center">
              {new Date(announcement.data.publishDate).toLocaleString(
                "default",
                {
                  month: "short",
                }
              )}
              {showYear &&
                new Date(announcement.data.publishDate).getFullYear()}
            </p>
          </div>
        </div>
        <div class="grid-col display-flex flex-column flex-justify-center  padding-right-2">
          <a
            class="usa-link usa-link--external font-sans-md"
            href={announcement.data.externalUrl}
          >
            {announcement.data.title}
          </a>
          <p class="margin-0">{announcement.body}</p>
        </div>
      </div>
    ))
  }
  <a href={url} class="usa-button margin-2">{buttonTitle}</a>
</div>
