---
const { title } = Astro.props;
---

<div class="usa-accordion usa-accordion--multiselectable" data-allow-multiple>
  <h4 class="usa-accordion__heading">
    <button
      type="button"
      class="usa-accordion__button"
      aria-expanded="false"
      aria-controls={title}
    >
      <h3>
        {title}
      </h3>
    </button>
  </h4>
  <div
    id={title}
    class="usa-accordion__content border radius-md border-base-lighter"
  >
    <slot />
  </div>
</div>
