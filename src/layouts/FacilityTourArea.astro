---
import ProgramAreaSidebar from "@/components/ProgramAreaSidebar.astro";
import RootLayout from "./RootLayout.astro";
import SidePageNavigation from "@/components/SidePageNavigation.astro";
import BreadCrumb from "@/components/BreadCrumb.astro";
import FacilityTourSidebar from "@components/FacilityTourSidebar.astro";

const { pageTitle } = Astro.props;
---

<RootLayout pageTitle={pageTitle}>
  <div class="display-flex">
    <FacilityTourSidebar />
    <SidePageNavigation>
      <BreadCrumb />
      <h1>{pageTitle}</h1>
      <slot />

      <div class=""></div>
    </SidePageNavigation>
  </div>
</RootLayout>
