---
import Accordian from "@/components/Accordian.astro";
import Collection from "@/components/Collection.astro";

const { areas, posts } = Astro.props;
---

<div class="usa-accordion usa-accordion--multiselectable" data-allow-multiple>
  {
    areas.map((area: any) => (
      <>
        <h2 id={area.title}>{area.title}</h2>
        {area.children && area.children.length > 0 && (
          <>
            {area.children.map(async (child: any) => (
              // TODO Filter posts
              <Accordian
                id={child.title}
                title={child.title}
                posts={posts.filter((post: any) =>
                  post.data.subcategories.includes(child.title)
                )}
                showDates={false}
              />
            ))}
          </>
        )}
        {!area.children && (
          <>
            {posts
              .filter(
                (post: any) => post.data.subcategories.includes(area.title) //first filter to only the items that fit this category
              )
              .map((post: any) => (
                <Collection post={post} showDates={false} /> //then build a collection item for each of them
              ))}
          </>
        )}
      </>
    ))
  }
</div>
