---
import ProgramAreaSidebar from "@/components/ProgramAreaSidebar.astro";
import Accordian from "../components/Accordian.astro";
import Collection from "../components/Collection.astro";
import RootLayout from "./RootLayout.astro";

const { programAreas, posts, pageTitle } = Astro.props;

const postCount = 4;

const recentPosts = posts
  .sort(
    (a: any, b: any) =>
      new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
  ) // a - b for oldest to most recent
  .slice(0, postCount);
---

<RootLayout pageTitle={pageTitle}>
  <div class="display-flex">
    <div class="margin-right-105">
      <div class="width-card-lg">
        <ProgramAreaSidebar />
      </div>
    </div>
    <div>
      <h1>{pageTitle}</h1>
      <slot />
      <div
        class="usa-accordion usa-accordion--multiselectable"
        data-allow-multiple
      >
        {
          programAreas.map((area: any) => (
            <>
              <h2 id={area.title}>{area.title}</h2>
              {area.children && area.children.length > 0 && (
                <>
                  {area.children.map(async (child: any) => (
                    // TODO Filter posts
                    <Accordian
                      id={child.title}
                      title={child.title}
                      posts={posts.filter((post: any) =>
                        post.data.subCategory.includes(child.title)
                      )}
                    />
                  ))}
                </>
              )}
              {!area.children && (
                <>
                  {posts
                    .filter(
                      (post: any) => post.data.subCategory.includes(area.title) //first filter to only the items that fit this category
                    )
                    .map((post: any) => (
                      <Collection post={post} /> //then build a collection item for each of them
                    ))}
                </>
              )}
            </>
          ))
        }
      </div>
    </div>
    <div class="margin-left-5">
      <p class="font-sans-lg text-light">Recently Updated for {pageTitle}</p>
      <ul class="usa-collection width-card-lg">
        {
          recentPosts &&
            recentPosts.map((post: any) => (
              <Collection post={post} isTruncated={true} />
            ))
        }
      </ul>
      <a class="usa-button">See More...</a>
    </div>
  </div>
</RootLayout>
