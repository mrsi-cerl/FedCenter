        <td>23</td>
      </tr>
      <tr>Plastic Rigid Foam, Polyisocyanurate/Polyurethane:</tr>
      <tr>
        <td>Rigid Foam</td>
        <td>--</td>
        <td>--</td>
        <td>9</td>
      </tr>
      <tr>
        <td>Foam-in-Place</td>
        <td>--</td>
