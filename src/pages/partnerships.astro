---
import PageWithSideBarNav from "@/layouts/PageWithSideBarNav.astro";
import RootLayout from "../layouts/RootLayout.astro";
import { getCollection } from "astro:content";
import OpportunitiesPages from "@/layouts/OpportunitiesPages.astro";
const pageTitle = "Partnerships";

const posts = await getCollection("partnershipPosts");

// TODO: get posts for each question on this page
const partnershipAreas = [
  {
    title: "Partnership Areas",
    children: [
      { title: "General" },
      { title: "Air Emissions" },
      { title: "Energy" },
      { title: "Hazardous Materials and Chemistry" },
      { title: "Solid Waste" },
      { title: "Transportation" },
      { title: "Water" },
    ],
  },
];
---

<RootLayout pageTitle={pageTitle}>
  <PageWithSideBarNav>
    <h1>{pageTitle}</h1>
    <div class="usa-prose">
      <p>
        The Partnerships page contains information on various Federal, State,
        public and private partnership programs. The list is arranged by media
        type.
      </p>
    </div>
    <OpportunitiesPages areas={partnershipAreas} posts={posts} />
  </PageWithSideBarNav>
</RootLayout>
