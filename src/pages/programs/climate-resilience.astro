---
import { getCollection } from "astro:content";
import ProgramPage from "../../layouts/ProgramPage.astro";

const climateResiliencePosts = await getCollection(
  "programPost",
  ({ data }) => {
    return data.programArea.includes("Climate Resilience");
  }
);

const pageTitle = "Climate Resilience";

const climateResilienceAreas = [
  {
    title: "Regulations, Guidance, and Policy",
    children: [
      { title: "Federal", url: "" },
      { title: "State", url: "" },
      { title: "International", url: "" },
      { title: "Agency-Specific Climate Change/Adaptation", url: "" },
    ],
  },

  {
    title: "Supporting Information and Tools",
    url: "",
    children: [
      { title: "Databases and Software Tools", url: "" },
      { title: "Directories, Catalogs, and Newsletters", url: "" },
      { title: "Libraries and Repositories", url: "" },
      { title: "Organizations and Programs", url: "" },
    ],
  },

  {
    title: "Lessons Learned",
    url: "",
    children: [
      { title: "Award Winners", url: "" },
      { title: "Case Studies", url: "" },
      { title: "Coastal Zones", url: "" },
      { title: "Water", url: "" },
    ],
  },

  { title: "Training, Presentations, and Briefings", url: "" },
  { title: "Conferences and Events", url: "" },
];
---

<ProgramPage
  programAreas={climateResilienceAreas}
  posts={climateResiliencePosts}
  pageTitle={pageTitle}
>
  <p>
    The Climate Resilience Program Area provides resources, tools, and lessons
    learned for organizations working to adjust to a changing climate to
    minimize negative effects and take advantage of new opportunities.
  </p>
  <p>
    When future Executive Orders (EOs) and Implementing Instructions for those
    EOs are released addressing federal facilities the text on this page will be
    updated.
  </p>
</ProgramPage>
