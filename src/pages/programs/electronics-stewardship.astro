---
import { getCollection } from "astro:content";
import ProgramPage from "../../layouts/ProgramPage.astro";

const electronicStewardshipPosts = await getCollection(
  "programPost",
  ({ data }) => {
    return data.programArea.includes("Electronics Stewardship");
  }
);

const pageTitle = "Electronics Stewardship";

const electronicStewardshipAreas = [
  {
    title: "Regulations, Guidance, and Policy",
  },
  {
    title: "Supporting Information and Tools",
    children: [
      { title: "Databases and Software Tools" },
      { title: "Directories, Catalogs, and Newsletters" },
      { title: "Libraries and Repositories" },
      { title: "Organizations and Programs" },
    ],
  },
  {
    title: "Lessons Learned",
    children: [
      { title: "Award Winners" },
      { title: "Case Studies" },
      { title: "Disposal" },
    ],
  },
  { title: "Training, Presentations, and Briefings" },
  { title: "Conferences and Events" },
];
---

<ProgramPage
  programAreas={electronicStewardshipAreas}
  posts={electronicStewardshipPosts}
  pageTitle={pageTitle}
>
  <p>
    The Electronics Stewardship Program Area addresses the life-cycle management
    of electronics from procurement to disposal.
  </p>
</ProgramPage>
