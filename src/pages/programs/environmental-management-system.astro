---
import { getCollection } from "astro:content";
import ProgramPage from "../../layouts/ProgramPage.astro";

const climateResiliencePosts = await getCollection(
  "programPost",
  ({ data }) => {
    return data.programArea.includes("Environmental Management System");
  }
);

const pageTitle = "Environmental Management System (EMS)";

const climateResilienceAreas = [
  {
    title: "Regulations, Guidance, and Policy",
    children: [
      { title: "Executive Orders" },
      { title: "Federal Agency Guidance and Policies" },
      { title: "EPA Guidance" },
      { title: "International Standards Organization (ISO)" },
    ],
  },
  {
    title: "Supporting Information and Tools",
    children: [
      { title: "Templates and Tools" },
      { title: "Libraries and Repositories" },
      { title: "Organizations" },
    ],
  },
  {
    title: "Lessons Learned",
    children: [
      { title: "Award Winners" },
      { title: "EMS Development" },
      { title: "EMS Examples and Case Studies" },
      { title: "Measuring EMS Implemenation and Success" },
    ],
  },
  { title: "Training, Presentations, and Briefings" },
  { title: "Conferences and Events" },
];
---

<ProgramPage
  programAreas={climateResilienceAreas}
  posts={climateResiliencePosts}
  pageTitle={pageTitle}
>
  <p>
    The EMS Program Area includes the latest guidance, examples, and resources
    for the development and implementation of processes and practices that
    enable an organization to reduce its environmental impacts and increase its
    operating efficiency.
  </p>
  <p>
    When future Executive Orders (EOs) and Implementing Instructions for those
    EOs are released addressing federal facilities the text on this page will be
    updated.
  </p>
</ProgramPage>
