---
import { programArea } from "@/constants";
import ProgramPage from "../../layouts/ProgramPage.astro";

const collectionName = programArea.CLEANUP;
const pageTitle = "Cleanup";

const cleanupAreas = [
  {
    title: "Regulations, Guidance, and Policy",
  },
  // TODO: Decide if this is fine with not having an accordian?
  {
    title: "Supporting Information and Tools",
    children: [
      { title: "Databases and Software Tools" },
      { title: "Directories, Catalogs, and Newsletters" },
      { title: "Libraries and Repositories" },
      { title: "Organizations" },
    ],
  },

  {
    title: "Lessons Learned",
    children: [
      { title: "General" },
      { title: "Award Winners" },
      { title: "BRAC" },
      { title: "Brownfields" },
      { title: "Collaboration Tools" },
      { title: "Munitions" },
      { title: "New Technology" },
      { title: "NPL" },
      { title: "Post Construction Completion" },
      { title: "Property Re-use" },
      { title: "Quality Assurance" },
      { title: "Remediation" },
      { title: "Substances of Concern" },
    ],
  },

  {
    title: "Learning Opportunities",
    children: [{ title: "Training, Presentations, and Briefings" }],
  },
  { title: "Conferences and Events" },
];
---

<ProgramPage
  programAreas={cleanupAreas}
  collectionName={collectionName}
  pageTitle={pageTitle}
>
  <p>
    The Cleanup Program Area encompasses the identification, remediation, and
    management of contaminated sites under the Superfund, the Base Realignment
    and Closure (BRAC), and the Brownfields programs.
  </p>
</ProgramPage>
