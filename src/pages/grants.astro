---
import PageWithSideBarNav from "@/layouts/PageWithSideBarNav.astro";
import RootLayout from "../layouts/RootLayout.astro";
import { getCollection } from "astro:content";
import OpportunitiesPages from "@/layouts/OpportunitiesPages.astro";
const pageTitle = "Grants";

const posts = await getCollection("grantPosts");

const grantAreas = [
  {
    title: "Grant Areas",
    children: [
      { title: "General" },
      { title: "Air" },
      { title: "Cleanup" },
      { title: "Climate Resilience" },
      { title: "Energy" },
      { title: "Natural Resources" },
      { title: "Pollution Prevention" },
      { title: "Solid Waste" },
      { title: "Sustainability" },
      { title: "Water" },
    ],
  },
];
---

<RootLayout pageTitle={pageTitle}>
  <PageWithSideBarNav>
    <h1>{pageTitle}</h1>
    <div class="usa-prose">
      <p>
        The Grants page contains information on various Federal, State and
        non-profit organization grant opportunities. The list is arranged by
        media type.
      </p>
    </div>
    <OpportunitiesPages areas={grantAreas} posts={posts} />
  </PageWithSideBarNav>
</RootLayout>
